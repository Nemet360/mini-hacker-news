<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="MinVer" Version="8.0.0" />
  </ItemGroup>

  <!-- Data access. One EF major, from $(EfVersion) in Directory.Build.props. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.33" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.33" />
  </ItemGroup>

  <!-- Transitive, pinned on purpose: EF 8.0.11 resolves SQLitePCLRaw 2.1.6, which
       carries HIGH severity advisories in the bundled SQLite build (2.1.11 is still
       affected by GHSA-2m69-gcr7-jv3q; 2.1.14 is clean). Central transitive
       pinning lifts it without moving the EF major.
       The CI job `vulnerable-packages` is what found this. -->
  <ItemGroup>
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
    <PackageVersion Include="SQLitePCLRaw.core" Version="2.1.14" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
    <PackageVersion Include="SQLitePCLRaw.provider.e_sqlite3" Version="2.1.14" />
  </ItemGroup>

  <!-- Test stack -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- FluentAssertions stays on 6.x deliberately: from 8.0 it is licensed per
         developer for commercial use. A test-library bump must not change what the
         repository costs to build. -->
    <PackageVersion Include="FluentAssertions" Version="6.12.2" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.33" />
  </ItemGroup>

</Project>
