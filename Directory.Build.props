<Project>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Required for IDE0005 (unnecessary using) to run on build; CS1591 would then demand XML docs everywhere. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EfVersion>8.0.33</EfVersion>
  </PropertyGroup>

  <!-- Reproducible builds on CI only; locally the source paths stay usable for debugging. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

  <!-- EF InMemory is banned: the requirement under test is persistence, and a
       provider that cannot be reopened by a second host cannot express it. -->
  <Target Name="BanEfInMemory" BeforeTargets="Build">
    <Error Condition="'%(PackageReference.Identity)' == 'Microsoft.EntityFrameworkCore.InMemory'"
           Text="Microsoft.EntityFrameworkCore.InMemory is banned in this repository: test against PostgreSQL, the engine we ship." />
  </Target>

</Project>
