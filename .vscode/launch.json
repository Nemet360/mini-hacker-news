{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MiniHn.Api (Swagger)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/MiniHn.Api/bin/Debug/net8.0/MiniHn.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/MiniHn.Api",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5085"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      }
    }
  ]
}
